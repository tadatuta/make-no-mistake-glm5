# CineLife Environment Variables
# Copy this file to .env.local and fill in your values

# OpenAI API Key (required for text generation)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Replicate API Token (required for image generation)
# Get your token at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your-replicate-token-here

# Analytics ID (optional)
# For Umami or other analytics
ANALYTICS_ID=your-analytics-id-here

# Site URL (optional, for production)
NEXT_PUBLIC_SITE_URL=https://cinelife.app
